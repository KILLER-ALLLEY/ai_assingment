<div class="container" style="max-width: 1000px; margin: 0 auto; padding: 40px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  
  <!-- Header -->
  <div style="text-align: center; margin-bottom: 50px;">
    <div style="display: inline-block; background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); padding: 60px 80px; border-radius: 20px; box-shadow: 0 20px 60px rgba(17, 153, 142, 0.3);">
      <h1 style="font-size: 3rem; color: white; margin: 0; font-weight: 700; text-shadow: 0 2px 10px rgba(0,0,0,0.2);">
        📞 Autodialer
      </h1>
      <p style="color: rgba(255,255,255,0.9); font-size: 1.2rem; margin-top: 10px; font-weight: 500;">
        Automated calling system
      </p>
    </div>
  </div>

  <!-- Contacts Table -->
  <div style="background: white; border-radius: 20px; padding: 40px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); overflow: hidden;">
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
        <thead>
          <tr style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <th style="padding: 18px 20px; text-align: left; color: white; font-weight: 600; font-size: 1.1rem; border-top-left-radius: 12px;">
              👤 Name
            </th>
            <th style="padding: 18px 20px; text-align: left; color: white; font-weight: 600; font-size: 1.1rem;">
              📱 Phone
            </th>
            <th style="padding: 18px 20px; text-align: left; color: white; font-weight: 600; font-size: 1.1rem;">
              📊 Status
            </th>
            <th style="padding: 18px 20px; text-align: center; color: white; font-weight: 600; font-size: 1.1rem; border-top-right-radius: 12px;">
              ⚡ Action
            </th>
          </tr>
        </thead>
        <tbody>
          <% @contacts.each_with_index do |contact, index| %>
            <tr style="background: <%= index.even? ? '#f8fafc' : 'white' %>; transition: all 0.3s;">
              <td style="padding: 20px; border-bottom: 1px solid #e2e8f0; color: #2d3748; font-weight: 600; font-size: 1.05rem;">
                <%= contact.name %>
              </td>
              <td style="padding: 20px; border-bottom: 1px solid #e2e8f0; color: #4a5568; font-size: 1rem; font-family: 'Courier New', monospace;">
                <%= contact.phone %>
              </td>
              <td style="padding: 20px; border-bottom: 1px solid #e2e8f0;">
                <span style="display: inline-block; padding: 8px 18px; background: <%= contact.status == 'completed' ? 'linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%)' : 'linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%)' %>; color: #2d3748; border-radius: 25px; font-size: 0.95rem; font-weight: 700; box-shadow: 0 3px 10px rgba(0,0,0,0.1);">
                  <%= contact.status.upcase %>
                </span>
              </td>
              <td style="padding: 20px; border-bottom: 1px solid #e2e8f0; text-align: center;">
                <%= button_to "📞 CALL NOW", calls_path(contact_id: contact.id), method: :post, style: "padding: 12px 28px; background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 1rem; transition: all 0.3s; box-shadow: 0 5px 20px rgba(17, 153, 142, 0.3); text-transform: uppercase;" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Empty State -->
  <% if @contacts.empty? %>
    <div style="text-align: center; padding: 60px 20px;">
      <div style="font-size: 4rem; margin-bottom: 20px;">📭</div>
      <h3 style="color: #4a5568; margin-bottom: 10px;">No Contacts Available</h3>
      <p style="color: #a0aec0; font-size: 1.1rem;">Upload a CSV file to get started with autodialing.</p>
    </div>
  <% end %>

</div>

<style>
  table tbody tr:hover {
    background: linear-gradient(135deg, #e6f7ff 0%, #f0e6ff 100%) !important;
    transform: scale(1.01);
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  }
  
  button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(17, 153, 142, 0.5) !important;
  }
  
  button:active {
    transform: translateY(-1px);
  }
</style>