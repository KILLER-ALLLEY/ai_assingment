<div style="
  max-width: 800px;
  margin: 40px auto;
  padding: 30px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  font-family: 'Segoe UI', Roboto, sans-serif;
  line-height: 1.6;
">

  <!-- ✅ Success or Notice Message -->
  <% if notice.present? %>
    <div style="
      background: #e8f7ec;
      color: #256d1b;
      padding: 10px 15px;
      border-radius: 8px;
      margin-bottom: 20px;
      font-weight: 500;
      text-align: center;
    ">
      <%= notice %>
    </div>
  <% end %>

  <!-- 📝 Blog Title -->
  <h1 style="
    font-size: 2.2rem;
    color: #222;
    margin-bottom: 20px;
    border-bottom: 2px solid #f0f0f0;
    padding-bottom: 10px;
  ">
    <%= @blog.title %>
  </h1>

  <!-- 📄 Blog Content -->
  <div style="color: #444; font-size: 1.05rem; margin-bottom: 30px;">
    <%= simple_format(@blog.content) %>
  </div>

  <!-- 🔗 Action Buttons -->
  <div style="display: flex; gap: 10px;">
    <%= link_to "✏️ Edit Blog", edit_blog_path(@blog),
      style: "background: #007bff; color: #fff; padding: 8px 15px; border-radius: 8px; text-decoration: none; font-weight: 500;" %>

    <%= link_to "⬅️ Back to Blogs", blogs_path,
      style: "background: #6c757d; color: #fff; padding: 8px 15px; border-radius: 8px; text-decoration: none; font-weight: 500;" %>

    <%= button_to "🗑️ Delete", @blog,
      method: :delete,
      data: { confirm: "Are you sure you want to delete this blog?" },
      style: "background: #dc3545; color: #fff; padding: 8px 15px; border-radius: 8px; border: none; cursor: pointer; font-weight: 500;" %>
  </div>
</div>
