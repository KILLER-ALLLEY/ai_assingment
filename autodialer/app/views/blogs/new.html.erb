<% content_for :title, "Create a New Blog" %>

<div style="
  max-width: 700px;
  margin: 50px auto;
  padding: 35px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  font-family: 'Segoe UI', Roboto, sans-serif;
  line-height: 1.6;
">

  <!-- 📝 Page Header -->
  <h1 style="
    font-size: 2rem;
    color: #222;
    margin-bottom: 25px;
    border-bottom: 2px solid #f0f0f0;
    padding-bottom: 10px;
  ">
    📝 Create a New Blog
  </h1>

  <!-- ✅ Blog Form -->
  <div style="margin-bottom: 25px;">
    <%= render "form", blog: @blog %>
  </div>

  <!-- 🔗 Action Buttons -->
  <div style="display: flex; gap: 10px;">
    <%= link_to "⬅️ Back to Blogs", blogs_path,
      style: "background: #6c757d; color: #fff; padding: 10px 16px; border-radius: 8px; text-decoration: none; font-weight: 500;" %>

    <%= link_to "🏠 Home", root_path,
      style: "background: #007bff; color: #fff; padding: 10px 16px; border-radius: 8px; text-decoration: none; font-weight: 500;" %>
  </div>
</div>
